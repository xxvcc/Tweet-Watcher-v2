{
  "name": "tweet-watcher-v2",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "X to Telegram watcher with an isolated, pinned twscrape collector",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "collector:install": "bash scripts/install-collector.sh",
    "test:collector": ".venv/bin/python -m unittest discover -s collector/tests -v",
    "verify": "npm run check && npm test && npm run test:collector"
  },
  "dependencies": {
    "@steipete/bird": "0.8.0",
    "bcryptjs": "^2.4.3",
    "express": "4.22.3",
    "proxy-addr": "2.0.8"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xxvcc/Tweet-Watcher-v2.git"
  }
}
