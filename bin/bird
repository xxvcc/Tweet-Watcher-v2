#!/usr/bin/env node
'use strict';
// A fixed, checked-in runner: no user-selected executable or CLI config loading.
const fs = require('node:fs');
async function main() {
  const blocked = require('../lib/runtime').blocked();
  if (blocked) {
    fs.writeSync(2, blocked.message);
    process.exitCode = 1;
    return;
  }
  const installed = require('@steipete/bird/package.json');
  if (installed.version !== '0.8.0') throw new Error('Unsupported bundled Bird version');
  const { TimelineClient, fetchTimeline } = await import('../lib/bird-timeline.mjs');
  const [username, count, sinceId] = process.argv.slice(2);
  const client = new TimelineClient({
    cookies: { authToken: process.env.AUTH_TOKEN, ct0: process.env.CT0 },
    timeoutMs: 15000, quoteDepth: 0,
  });
  const result = await fetchTimeline(client, { username, count: Number(count), sinceId });
  fs.writeSync(1, JSON.stringify(result));
}
main().catch((error) => {
  // Only adapter-generated diagnostics are emitted; never print upstream bodies,
  // credentials, URLs or a dependency exception that could include request data.
  const message = String(error?.message || '');
  const safe = /^(Incomplete X timeline: [a-z -]+|X timeline HTTP \d{3}|X account lookup failed|Invalid timeline request|Unsupported bundled Bird version)$/.test(message);
  fs.writeSync(2, safe ? message : 'X timeline request failed');
  process.exitCode = 1;
});
